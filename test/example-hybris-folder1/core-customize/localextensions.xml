<?xml version="1.0" encoding="UTF-8"?>
<!-- Master File to load all needed Hybris extensions -->
<hybrisconfig xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:noNamespaceSchemaLocation="resources/schemas/extensions.xsd">
  <extensions>
    <path dir="${HYBRIS_BIN_DIR}" />

    <extension name="backoffice" />
    <extension name="ldap" />
    <extension name="customexample" />
    <extension name="customsmartedit" />

  </extensions>
</hybrisconfig>
